<div class="hsn-collection-list-home">

{% for block in section.blocks %}
  {% liquid
    assign collection = collections[block.settings.collection]
    assign title = collection.title
    if block.settings.title_override != blank
      assign title = block.settings.title_override
    endif
    assign image = collection.featured_image
    if block.settings.image
      assign image = block.settings.image
    endif
  
  %}
  <div class="hsn-collection-list-home-tile">
    <div class="hsn-collection-list-home-image">
    <a href="{{ collection.url }}">
      <img src="{{ image | img_url: '300x300' }}" alt="{{ altText | escape }}" width="300" height="300" />
    </a>
    </div>
    
      <div class="hsn-collection-list-home-title">
        <a href="{{ collection.url }}">{{ title }}</a>
      </div>
  </div>
{% endfor %}

</div>